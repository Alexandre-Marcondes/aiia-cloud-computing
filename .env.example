# Template for the gitignored repo-root `.env` that configures the scripts in
# deploy/. It contains PLACEHOLDER values only -- no real cloud resource
# identifier or machine path is committed anywhere.
#
#   cp .env.example .env
#   $EDITOR .env
#
# The scripts source `.env` automatically via `deploy/_env.sh`; a value already
# exported in the environment overrides the file, so a one-off target change is:
#   VM_HOST=1.2.3.4 deploy/sync.sh
#
# This is shell syntax, so every value is quoted and a value with spaces stays
# one value. A script that needs a variable and finds it unset stops with a
# message naming the variable and this file. Optional values (those with a
# working default in the scripts) are listed commented-out at the bottom.

# --- Part 2: the Azure VM (deploy/sync.sh, stream_vm.sh, sweep_vm.sh,
#     reset_vm_outputs.sh) ---
VM_HOST="<vm-public-ip>"
VM_USER="<vm-ssh-user>"
VM_KEY="<path-to-vm-ssh-private-key>"
VM_DIR="<checkout-path-on-the-vm>"

# --- Part 3: serverless resources (deploy/deploy_function.sh, deploy_web.sh,
#     reset_serverless.sh, stream_serverless.sh, sweep_serverless.sh,
#     measure_part3.sh, provision_part3.sh, cost.sh,
#     scripts/build_architecture_diagram.py) ---
RG="<serverless-resource-group>"
STORAGE="<storage-account-name>"
FUNC="<function-app-name>"
VISION="<vision-account-name>"

# --- Part 2/3 cost report (deploy/cost.sh): space-separated resource groups ---
RGS="<vm-resource-group> <serverless-resource-group>"

# --- Optional: defaults shown; uncomment only to override ---
#WEB_ROOT="/var/www/html"        # Apache document root on the VM
#UNIT_USER=""                    # run-as user for sls-receiver.service; defaults to
#                                # the user running deploy/setup_vm.sh (or $SUDO_USER)
#UNIT_WORKDIR=""                 # ExecStart working directory; defaults to the VM
#                                # checkout root, i.e. the dir containing deploy/
#UNIT_VENV=""                    # venv prefix for the unit's Python; defaults to $VENV
#LOCAL_PORT="8000"               # local end of the SSH forward opened by stream_vm.sh
#RAW_CONTAINER="raw"             # input container of the serverless pipeline
#WEB_CONTAINER='$web'            # static-site container of the serverless pipeline
#SUBS="raw-blob-created"         # Event Grid subscription name (Part 3)
